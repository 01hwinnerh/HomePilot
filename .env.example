# 应用基础
APP_NAME=HomePilot API
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Auth：本地 .env 必须替换为随机值，禁止提交真实密钥
AUTH_JWT_SECRET=replace-with-a-local-random-secret
AUTH_JWT_ISSUER=homepilot-api
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=7
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_REFRESH_COOKIE_NAME=refresh_token
AUTH_CSRF_COOKIE_NAME=csrf_token
AUTH_COOKIE_PATH=/api/v1/auth
AUTH_CSRF_COOKIE_PATH=/
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_REQUEST_RATE_LIMIT_MAX_ATTEMPTS=120
AUTH_REQUEST_RATE_LIMIT_WINDOW_SECONDS=60

# 演示身份：只用于本地 seed，真实值仅填写到未提交的 .env
DEMO_SEED_PASSWORD=

# MySQL：本地 Docker 的默认账号仅用于开发，不可用于生产
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=homepilot
# 测试库名必须包含 test，且不得与 MYSQL_DATABASE 同名
MYSQL_TEST_DATABASE=homepilot_test
MYSQL_USER=homepilot
MYSQL_PASSWORD=change-me-local
MYSQL_ROOT_PASSWORD=change-me-root-local
DATABASE_URL=mysql+asyncmy://homepilot:change-me-local@127.0.0.1:3306/homepilot
TEST_DATABASE_URL=mysql+asyncmy://homepilot:change-me-local@127.0.0.1:3306/homepilot_test

# Redis / Celery
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# Qdrant / MinIO
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=homepilot_knowledge
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=homepilot-minio
MINIO_SECRET_KEY=change-me-minio-local
MINIO_BUCKET=homepilot-assets
MINIO_SECURE=false

# 模型与 Provider：请仅在本地 .env 填写真实 Key
LLM_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
DEEPSEEK_API_KEY=
EMBEDDING_PROVIDER=local
RERANKER_PROVIDER=local
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=

# LangSmith：可选，未配置时不上传 Trace
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=homepilot-ai-dev
LANGSMITH_API_KEY=

# Docker 镜像：Qdrant/MinIO 首次拉取成功后会记录精确 tag 与 digest
QDRANT_IMAGE=qdrant/qdrant@sha256:057ee3a8da769fe7310dd3537b4dc7583bf87a95ce8ac43c0af5a46bc580d1fc
MINIO_IMAGE=minio/minio@sha256:14cea493d9a34af32f524e538b8346cf79f3321eff8e708c1e2960462bd8936e
